# HeartBridge runtime configuration. Copy to .env and adjust; never commit real
# credentials. Every variable is optional and falls back to the documented default.

# Deployment label used in structured logs.
HEARTBRIDGE_ENV=development

# HTTP listen address of the API server.
HEARTBRIDGE_HTTP_ADDR=:8080

# SQLite database file. The parent directory is created at startup.
HEARTBRIDGE_DB_PATH=data/heartbridge.sqlite

# How long a writer waits for a competing writer before giving up.
HEARTBRIDGE_DB_BUSY_TIMEOUT=5s

# Upper bound of the connection pool.
HEARTBRIDGE_DB_MAX_OPEN_CONNS=8

# Lifetime of a freshly issued session token.
HEARTBRIDGE_SESSION_TTL=12h

# Retention window of an Idempotency-Key replay record.
HEARTBRIDGE_IDEMPOTENCY_TTL=24h

# Per-request deadline propagated to the service and storage layers.
HEARTBRIDGE_REQUEST_TIMEOUT=15s

# Grace period granted to in-flight requests during shutdown.
HEARTBRIDGE_SHUTDOWN_TIMEOUT=20s

# Notification outbox dispatcher.
HEARTBRIDGE_NOTIFICATION_INTERVAL=2s
HEARTBRIDGE_NOTIFICATION_BATCH=20

# Expiry sweeper for unanswered introductions, stale sessions and replay records.
HEARTBRIDGE_SWEEPER_INTERVAL=30s
HEARTBRIDGE_SWEEPER_BATCH=50

# One of debug, info, warn, error.
HEARTBRIDGE_LOG_LEVEL=info

# Optional first operations account, seeded once at startup. Both variables must
# be provided together. Use a placeholder here and inject the real value through
# your secret store.
HEARTBRIDGE_BOOTSTRAP_ADMIN_EMAIL=
HEARTBRIDGE_BOOTSTRAP_ADMIN_PASSWORD=
